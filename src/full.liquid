<div id="{{ wt_id }}" class="layout rounded image-dither"></div>

<script type="module">
  new window.TRMNLWatchtower(
    '{{ wt_id }}',
    {
      width: {{ full_width }},
      height: {{ full_height }},
      offsetY: 360,
      layerHeight: 200,
      grid: 12
    }
  );
</script>