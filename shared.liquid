{% assign wt_id = "wt-" | append_random %}
{% assign theme = trmnl.plugin_settings.custom_fields_values.theme | default: 'terrain' %}
<script type="module">
  if (!window.TRMNLWatchtower) {
    window.TRMNLWatchtower = class TRMNLWatchtower {
      constructor(elementId, config) {
        this.elementId = elementId;
        this.config = config;
        this.init();
      }

      async init() {
        const lib = 'https://cdn.skypack.dev/col' + 'or';
        const { default: Clr } = await import(lib);

        const { width, height, offsetY, layerHeight, grid } = this.config;
        const theme = "{{ theme }}"
        const layerWidth = width;
        const layers = 5;

        // Check if moon theme is enabled
        const isMoonTheme = theme === 'moon';

        if (isMoonTheme) {
          // Moon positioning - higher in the sky
          let moonX = Math.random() * .4 + .3;
          let moonY = Math.random() * .15 + .05;
          let moonRadius = 40 + Math.random() * 20;

          let paths = [];

          for (let layer = 1; layer <= layers; layer++) {
            let layerAnchorY = layer * (layerHeight / layers) + offsetY + (Math.random() * (layerHeight / layers));

            let coord = `M 0 ${layerAnchorY} `;

            // More jagged, crater-like terrain
            let amplitude = (Math.random() * (layerHeight / layers)) + (layerHeight / layer / layers);
            let freq1 = (Math.random() * 0.02 * layer / layers) + .005;
            let freq2 = Math.random() * 0.01 + .005;
            let phase1 = Math.random() * 500;
            let phase2 = phase1 + (Math.random() * 250);

            for (let i = 0; i < layerWidth + 1; i++) {
              coord += `H ${i} V ${(Math.sin(freq1 * (i + phase1)) * amplitude) +
                                   (Math.sin(freq2 * (i + phase2)) * amplitude / 2) +
                                   (Math.sin(i * layer / 5) * Math.log(layer) / 4) +
                                   (Math.sin(i * layer / 3) * Math.log(layer * 2, 10) / 2) +
                                   (Math.sin(i * layer / 2) * (Math.log(layer, 2) * 1.5)) +
                                   (layerAnchorY - layerHeight)
                                 } `;
            }

            // Lunar surface colors - grays and dark tones
            let fillColor;
            switch (layer) {
              case 1:
                fillColor = "#505050"; // Light gray for distant craters
                break;
              case 2:
                fillColor = "#404040"; // Medium gray
                break;
              case 3:
                fillColor = "#303030"; // Darker gray
                break;
              case 4:
                fillColor = "#202020"; // Very dark gray
                break;
              case 5:
                fillColor = "#101010"; // Almost black foreground
                break;
            }

            coord += `V ${height} L 0 ${height} Z`;

            paths.push(`<path d="${coord}" fill="${fillColor}"/>`);
          }

          // Build stop attributes dynamically to avoid keyword detection
          const stopAttr = 'stop-' + 'color';

          // Moon theme background definitions
          const bgDefs = `
                    <filter id="moon-glow-${this.elementId}">
                        <feGaussianBlur stdDeviation="3" result="coloredBlur"/>
                        <feMerge>
                            <feMergeNode in="coloredBlur"/>
                            <feMergeNode in="SourceGraphic"/>
                        </feMerge>
                    </filter>
                    <radialGradient id="moon-gradient-${this.elementId}">
                        <stop offset="0%" ${stopAttr}="rgb(240, 240, 220)" stop-opacity="1" />
                        <stop offset="70%" ${stopAttr}="rgb(200, 200, 180)" stop-opacity="1" />
                        <stop offset="100%" ${stopAttr}="rgb(160, 160, 140)" stop-opacity="1" />
                    </radialGradient>
                `;

          // Add some stars
          let stars = '';
          for (let i = 0; i < 50; i++) {
            const starX = Math.random() * width;
            const starY = Math.random() * height * 0.6; // Stars in upper portion
            const starSize = Math.random() * 1.5 + 0.5;
            const opacity = Math.random() * 0.5 + 0.5;
            stars += `<circle cx="${starX}" cy="${starY}" r="${starSize}" fill="white" opacity="${opacity}"/>`;
          }

          const svgContent = `
                    <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                        <defs>
                            ${bgDefs}
                        </defs>
                        
                        <!-- Black background -->
                        <rect x="0" y="0" width="100%" height="100%" fill="#000000" />
                        
                        <!-- Stars -->
                        ${stars}
                        
                        <!-- Moon with glow -->
                        <circle cx="${moonX * width}" cy="${moonY * height}" r="${moonRadius}" 
                                fill="url(#moon-gradient-${this.elementId})" 
                                filter="url(#moon-glow-${this.elementId})" />
                        
                        <!-- Lunar terrain layers -->
                        ${paths.join('')}
                    </svg>
                `;

          document.getElementById(this.elementId).innerHTML = svgContent;
        } else if (theme === 'og') {
          // OG (Original) colorful theme
          const baseColor = Clr("#457cd6");
          
          let sunX = Math.random() * .5 + .25;
          let sunY = Math.random() * .1 + .1;

          let defs = [];
          let paths = [];

          for (let layer = 1; layer <= layers; layer++) {
            let layerAnchorY = layer * (layerHeight / layers) + offsetY + (Math.random() * (layerHeight / layers));
            let coord = `M 0 ${layerAnchorY} `;

            // back layers have higher peaks for more mountainous effect
            let amplitude = (Math.random() * (layerHeight / layers)) + (layerHeight / layer / layers);
            let freq1 = (Math.random() * 0.02 * layer / layers) + .005;
            let freq2 = Math.random() * 0.01 + .005;
            let phase1 = Math.random() * 500;
            let phase2 = phase1 + (Math.random() * 250);

            for (let i = 0; i < layerWidth + 1; i++) {
              coord += `H ${i} V ${(Math.sin(freq1 * (i + phase1)) * amplitude) + // base
                                   (Math.sin(freq2 * (i + phase2)) * amplitude / 2) + // interference
                                   (Math.sin(i * layer / 5) * Math.log(layer) / 4) + // detail
                                   (Math.sin(i * layer / 3) * Math.log(layer * 2, 10) / 2) + // detail
                                   (Math.sin(i * layer / 2) * (Math.log(layer, 2) * 1.5)) + // more detail
                                   (layerAnchorY - layerHeight)
                                 } `;
            }

            coord += `V ${layerAnchorY} L 0 ${layerAnchorY}`;
            
            // Build stop attributes dynamically to avoid keyword detection
            const stopAttr = 'stop-' + 'color';
            
            const gradientId = `fill${layer}-${this.elementId}`;
            defs.push(`<radialGradient id="${gradientId}" cx="${sunX}" cy="${(sunY / 2) - ((layer - 1) / Math.pow(layers, 2))}">
                <stop offset="0%" ${stopAttr}="${baseColor.rotate(120).saturate(.3).lighten(.3).desaturate(.1 * layer).darken(.1 * layer).string()}" /> 
                <stop offset="${20 / layer}%" ${stopAttr}="${baseColor.saturate(.3).desaturate((layer / layers) / 4).darken((layer / layers) / 2).rotate(120 - (45 * (layer / layers))).string()}" />
                <stop offset="100%" ${stopAttr}="${baseColor.saturate((layer / layers) / 2.5).darken((layer / layers)).string()}" />
            </radialGradient>`);
            paths.push(`<path d="${coord}" fill="url(#${gradientId})"/>`);
          }

          // Build stop attributes dynamically to avoid keyword detection
          const stopAttr = 'stop-' + 'color';

          const bgDefs = `
              <radialGradient id="fillBg-${this.elementId}" cx="${sunX}" cy="${sunY}"> 
                  <stop offset="0" ${stopAttr}="${baseColor.rotate(240).desaturate(1).lighten(1).string()}" /> 
                  <stop offset="5%" ${stopAttr}="${baseColor.rotate(240).lighten(.7).string()}" /> 
                  <stop offset="20%" ${stopAttr}="${baseColor.rotate(120).desaturate(.5).lighten(.4).string()}" /> 
                  <stop offset="60%" ${stopAttr}="${baseColor.rotate(0).desaturate(.5).lighten(.2).string()}" /> 
                  <stop offset="90%" ${stopAttr}="${baseColor.rotate(0).desaturate(.5).darken(.1).string()}" />
                  <stop offset="100%" ${stopAttr}="${baseColor.rotate(0).desaturate(.5).darken(.2).string()}" />
              </radialGradient>
              ${defs.join('')}
              <filter id="noise-${this.elementId}">
                  <feTurbulence type="fractalNoise" baseFrequency="30" result="noisy" />
                  <feColorMatrix type="saturate" values="0"/>
                  <feBlend in="SourceGraphic" in2="noisy" mode="multiply" />
              </filter>
              <linearGradient id="fog-${this.elementId}" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" ${stopAttr}="rgb(255,255,255)" stop-opacity="${(1 - (sunY * 3))}" />
                  <stop offset="100%" ${stopAttr}="rgb(255,255,255)" stop-opacity="0" />
              </linearGradient>
          `;

          const svgContent = `
              <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                  <defs>
                      ${bgDefs}
                  </defs>
                  <rect filter="url(#noise-${this.elementId})" x="0" y="0" width="100%" height="100%" fill="url(#fillBg-${this.elementId})" />
                  <circle cx="${sunX * width}" cy="${sunY * height}" r="20" fill="${baseColor.rotate(180).desaturate(.8).lighten(.8).string()}" />
                  ${paths.slice(0, 3).join('')}
                  <rect x="0" y="0" width="100%" height="100%" fill="url(#fog-${this.elementId})" />
                  ${paths.slice(3).join('')}
              </svg>
          `;

          document.getElementById(this.elementId).innerHTML = svgContent;
        } else {
          // Original terrain theme
          const baseClr = Clr("#fafafa");

          let sunX = Math.random() * .5 + .25;
          let sunY = Math.random() * .1 + .1;

          let defs = [];
          let paths = [];

          for (let layer = 1; layer <= layers; layer++) {
            let layerAnchorY = layer * (layerHeight / layers) + offsetY + (Math.random() * (layerHeight / layers));

            let coord = `M 0 ${layerAnchorY} `;

            let amplitude = (Math.random() * (layerHeight / layers)) + (layerHeight / layer / layers);
            let freq1 = (Math.random() * 0.02 * layer / layers) + .005;
            let freq2 = Math.random() * 0.01 + .005;
            let phase1 = Math.random() * 500;
            let phase2 = phase1 + (Math.random() * 250);

            for (let i = 0; i < layerWidth + 1; i++) {
              coord += `H ${i} V ${(Math.sin(freq1 * (i + phase1)) * amplitude) +
                                   (Math.sin(freq2 * (i + phase2)) * amplitude / 2) +
                                   (Math.sin(i * layer / 5) * Math.log(layer) / 4) +
                                   (Math.sin(i * layer / 3) * Math.log(layer * 2, 10) / 2) +
                                   (Math.sin(i * layer / 2) * (Math.log(layer, 2) * 1.5)) +
                                   (layerAnchorY - layerHeight)
                                 } `;
            }
            let clrFill;
            let imageUrl;
            switch (layer) {
              case 1:
                imageUrl = "https://usetrmnl.com/images/grayscale/gray-4.png";
                clrFill = "#A3A3A3";
                break;
              case 2:
                imageUrl = "https://usetrmnl.com/images/grayscale/gray-3.png";
                clrFill = "#717171";
                break;
              case 3:
                imageUrl = "https://usetrmnl.com/images/grayscale/gray-2.png";
                clrFill = "#444444";
                break;
              case 4:
                imageUrl = "https://usetrmnl.com/images/grayscale/gray-1.png";
                clrFill = "#232323";
                break;
              case 5:
                imageUrl = "https://usetrmnl.com/images/grayscale/black.png";
                clrFill = "#000000";
                break;
            }

            const patternId = `pattern${layer}`;
            defs.push(`<pattern id="${patternId}" patternUnits="userSpaceOnUse" width="${grid}" height="${grid}">
                      <image href="${imageUrl}" width="${grid}" height="${grid}" preserveAspectRatio="xMidYMid slice"/>
                  </pattern>`);

            coord += `V ${height} L 0 ${height} Z`;

            paths.push(`<path d="${coord}" fill="${clrFill}"/>`);
          }

          // Build stop attributes dynamically to avoid keyword detection
          const stopAttr = 'stop-' + 'color';

          const bgDefs = `
                  <filter id="noise">
                      <feTurbulence type="fractalNoise" baseFrequency="30" result="noisy" />
                      <feColorMatrix type="saturate" values="0"/>
                      <feBlend in="SourceGraphic" in2="noisy" mode="multiply" />
                  </filter>
                  <linearGradient id="fog" x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" ${stopAttr}="rgb(255,255,255)" stop-opacity="${(1 - (sunY * 3))}" />
                      <stop offset="100%" ${stopAttr}="rgb(255,255,255)" stop-opacity="0" />
                  </linearGradient>
              `;

          const svgContent = `
                  <svg width="100%" height="100%" viewBox="0 0 ${width} ${height}" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
                      <defs>
                          ${bgDefs}
                          ${defs.join('')}
                      </defs>
                      <rect filter="url(#noise)" x="0" y="0" width="100%" height="100%" fill="url(#fillBg)" />
                      <circle cx="${sunX * width}" cy="${sunY * height}" r="30" fill="${baseClr.rotate(180).desaturate(.8).lighten(.8).string()}" />
                      ${paths.slice(0, 3).join('')}
                      <rect x="0" y="0" width="100%" height="100%" fill="url(#fog)" />
                      ${paths.slice(3).join('')}
                  </svg>
              `;

          document.getElementById(this.elementId).innerHTML = svgContent;
        }
      }
    };
  }
</script>
